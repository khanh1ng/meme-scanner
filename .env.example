# Copy to .env and load it into your shell. Never commit .env.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# optional language-model overlay (off by default)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_MODEL=deepseek/deepseek-v4-flash
# where cached data lives (default: ./data)
MEMESCAN_CACHE=./data
